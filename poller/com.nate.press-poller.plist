<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nate.press-poller</string>

  <!-- chatdb-dump is the main executable on purpose: TCC grants Full Disk
       Access to the process launchd starts and credits its children to it, so
       python3 as the parent would be denied no matter what the child is
       granted. The binary dumps the chat, then execs the Python poller.
       Both live in Application Support, not the repo; install.sh copies them. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/natestephenson/Library/Application Support/press-poller/chatdb-dump</string>
    <string>--launch</string>
    <string>3184</string>
  </array>

  <!-- Every 5 minutes. One pass, one SQLite read through chatdb-dump, a
       handful of REST calls when something new was shared. -->
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>

  <!-- One appended log. Not under ~/Documents: iCloud evicts files there. -->
  <key>StandardOutPath</key>
  <string>/Users/natestephenson/.local/state/press-poller/poller.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/natestephenson/.local/state/press-poller/poller.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
